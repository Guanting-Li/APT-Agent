# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# --- Metasploit RPC (msfrpcd) ---
MSF_PASSWORD=your-msf-rpc-password
MSF_PORT=55553

# --- Module rectification database (MySQL) ---
MYSQL_HOST=127.0.0.1
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=art_agent

# --- Network (attacker host on the lab network) ---
LOCAL_IP=10.0.0.1

# --- Optional ---
# WORDLIST_PATH=/path/to/userpass.txt
